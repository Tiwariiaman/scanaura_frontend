# ============================================================
# SCANAURA - FLUTTER WEB PRODUCTION
# ============================================================

RewriteEngine On

# ============================================================
# FLUTTER WEB - SPA ROUTING
# ============================================================

# Serve existing files and directories normally.
# Everything else goes to Flutter's index.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]


# ============================================================
# CACHE CONTROL
# ============================================================

<IfModule mod_headers.c>

    # --------------------------------------------------------
    # Flutter entry/startup files
    #
    # Always revalidate these so a new deployment is picked up.
    # --------------------------------------------------------

    <FilesMatch "^(index\.html|flutter_bootstrap\.js)$">
        Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>


    # --------------------------------------------------------
    # JavaScript / Dart application bundle
    #
    # Revalidate on every deployment.
    # --------------------------------------------------------

    <FilesMatch "\.(js)$">
        Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>


    # --------------------------------------------------------
    # JSON
    # --------------------------------------------------------

    <FilesMatch "\.json$">
        Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>


    # --------------------------------------------------------
    # WASM
    # --------------------------------------------------------

    <FilesMatch "\.wasm$">
        Header always set Cache-Control "public, max-age=604800, must-revalidate"
    </FilesMatch>


    # --------------------------------------------------------
    # Static assets
    #
    # Images/fonts/icons can safely be cached.
    # --------------------------------------------------------

    <FilesMatch "\.(css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|otf)$">
        Header always set Cache-Control "public, max-age=604800, must-revalidate"
    </FilesMatch>


    # --------------------------------------------------------
    # SEO files
    # --------------------------------------------------------

    <FilesMatch "^(robots\.txt|sitemap\.xml)$">
        Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>

</IfModule>